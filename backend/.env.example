# All optional. Secrets are set as environment variables, never committed: TRACE_INGEST_TOKEN, TRACE_VIEW_TOKEN, ANTHROPIC_API_KEY (optional), ABUSEIPDB_API_KEY (optional).
PORT=8080
# Comma-separated browser origins allowed to call the API when the front end is hosted elsewhere.
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_REQUEST_BYTES=2097152
